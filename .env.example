# Groq API key — powers every agent's LLM call (llama-3.3-70b-versatile).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GNews API key — used by the Sentiment Agent to fetch India-market
# headlines (country=in). Optional: if unset, the Sentiment Agent runs
# with an empty headline set and the LLM still returns a NEUTRAL-leaning
# signal instead of failing.
# Get one at https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here
